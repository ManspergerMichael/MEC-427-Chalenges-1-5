        <mxCell id="jSYX08KPYPl2HT-AbTag-26" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;EMI Chart&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
